@model HospitalManagementSystem.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<div class="container mt-4">

    <h2>Delete Department</h2>

    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this department?</strong>
    </div>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Department ID
        </dt>

        <dd class="col-sm-9">
            @Model.DepartmentId
        </dd>

        <dt class="col-sm-3">
            Department Name
        </dt>

        <dd class="col-sm-9">
            @Model.DepartmentName
        </dd>

        <dt class="col-sm-3">
            Description
        </dt>

        <dd class="col-sm-9">
            @Model.Description
        </dd>

        <dt class="col-sm-3">
            Location
        </dt>

        <dd class="col-sm-9">
            @Model.Location
        </dd>

        <dt class="col-sm-3">
            Contact Number
        </dt>

        <dd class="col-sm-9">
            @Model.ContactNumber
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="DepartmentId" />

        <button type="submit"
                class="btn btn-danger">
            Delete Department
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>