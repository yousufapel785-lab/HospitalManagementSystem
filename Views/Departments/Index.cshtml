@model IEnumerable<HospitalManagementSystem.Models.Department>

@{
    ViewData["Title"] = "Department Management";
}

<div class="container mt-4">
    @if (TempData["DeleteError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Cannot Delete!</strong>
            @TempData["DeleteError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["DeleteSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong>
            @TempData["DeleteSuccess"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }
    
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Department Management</h2>

        <a asp-action="Create"
           class="btn btn-primary">
            Add New Department
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No departments found.
            Click <strong>Add New Department</strong>
            to add a department.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>
                            Department ID
                        </th>

                        <th>
                            Department Name
                        </th>

                        <th>
                            Description
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Contact Number
                        </th>

                        <th>
                            Actions
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var department in Model)
                    {
                        <tr>

                            <td>
                                @department.DepartmentId
                            </td>

                            <td>
                                @department.DepartmentName
                            </td>

                            <td>
                                @department.Description
                            </td>

                            <td>
                                @department.Location
                            </td>

                            <td>
                                @department.ContactNumber
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@department.DepartmentId"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@department.DepartmentId"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@department.DepartmentId"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>