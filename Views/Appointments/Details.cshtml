@model HospitalManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container mt-4">

    <h2>Appointment Details</h2>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">Appointment ID</dt>
        <dd class="col-sm-9">@Model.AppointmentId</dd>

        <dt class="col-sm-3">Patient</dt>
        <dd class="col-sm-9">@Model.Patient?.FullName</dd>

        <dt class="col-sm-3">Doctor</dt>
        <dd class="col-sm-9">@Model.Doctor?.FullName</dd>

        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.AppointmentDate.ToString("dd-MM-yyyy")</dd>

        <dt class="col-sm-3">Time</dt>
        <dd class="col-sm-9">@Model.AppointmentTime</dd>

        <dt class="col-sm-3">Reason</dt>
        <dd class="col-sm-9">@Model.Reason</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

    </dl>

    <div class="mt-3">

        <a asp-action="Edit"
           asp-route-id="@Model.AppointmentId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </div>

</div>