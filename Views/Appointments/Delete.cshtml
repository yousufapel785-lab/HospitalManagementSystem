@model HospitalManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container mt-4">

    <h2>Delete Appointment</h2>

    <div class="alert alert-danger mt-3">
        Are you sure you want to delete this appointment?
    </div>

    <dl class="row mt-3">

        <dt class="col-sm-3">Patient</dt>
        <dd class="col-sm-9">@Model.Patient?.FullName</dd>

        <dt class="col-sm-3">Doctor</dt>
        <dd class="col-sm-9">@Model.Doctor?.FullName</dd>

        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.AppointmentDate.ToString("dd-MM-yyyy")</dd>

        <dt class="col-sm-3">Time</dt>
        <dd class="col-sm-9">@Model.AppointmentTime</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

    </dl>

    <form asp-action="Delete" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="AppointmentId" />

        <button type="submit"
                class="btn btn-danger">
            Delete Appointment
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>