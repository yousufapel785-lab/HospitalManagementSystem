@model HospitalManagementSystem.Models.Doctor

@{
    ViewData["Title"] = "Add Doctor";
}

<div class="container mt-4">

    <h2>Add New Doctor</h2>

    <hr />

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="row">

            <!-- Full Name -->
            <div class="col-md-6 mb-3">
                <label asp-for="FullName" class="form-label">
                    Full Name
                </label>

                <input asp-for="FullName"
                       class="form-control"
                       placeholder="Enter doctor's full name" />

                <span asp-validation-for="FullName"
                      class="text-danger">
                </span>
            </div>


            <!-- Specialization -->
            <div class="col-md-6 mb-3">
                <label asp-for="Specialization" class="form-label">
                    Specialization
                </label>

                <input asp-for="Specialization"
                       class="form-control"
                       placeholder="e.g. Cardiology" />

                <span asp-validation-for="Specialization"
                      class="text-danger">
                </span>
            </div>


            <!-- Qualification -->
            <div class="col-md-6 mb-3">
                <label asp-for="Qualification" class="form-label">
                    Qualification
                </label>

                <input asp-for="Qualification"
                       class="form-control"
                       placeholder="e.g. MBBS, FCPS" />

                <span asp-validation-for="Qualification"
                      class="text-danger">
                </span>
            </div>


            <!-- Phone -->
            <div class="col-md-6 mb-3">
                <label asp-for="Phone" class="form-label">
                    Phone
                </label>

                <input asp-for="Phone"
                       class="form-control"
                       placeholder="Enter phone number" />

                <span asp-validation-for="Phone"
                      class="text-danger">
                </span>
            </div>


            <!-- Email -->
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Enter email address" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>


            <!-- Available Days -->
            <div class="col-md-6 mb-3">
                <label asp-for="AvailableDays" class="form-label">
                    Available Days
                </label>

                <input asp-for="AvailableDays"
                       class="form-control"
                       placeholder="e.g. Sunday, Tuesday, Thursday" />

                <span asp-validation-for="AvailableDays"
                      class="text-danger">
                </span>
            </div>


            <!-- Available Time -->
            <div class="col-md-6 mb-3">
                <label asp-for="AvailableTime" class="form-label">
                    Available Time
                </label>

                <input asp-for="AvailableTime"
                       class="form-control"
                       placeholder="e.g. 5:00 PM - 8:00 PM" />

                <span asp-validation-for="AvailableTime"
                      class="text-danger">
                </span>
            </div>


            <!-- Department ID -->
            <div class="col-md-6 mb-3">
                <label asp-for="DepartmentId" class="form-label">
                    Department ID
                </label>

                <input asp-for="DepartmentId"
                       class="form-control"
                       type="number"
                       placeholder="Enter Department ID" />

                <span asp-validation-for="DepartmentId"
                      class="text-danger">
                </span>

                <small class="text-muted">
                    Enter the ID of an existing department.
                </small>
            </div>

        </div>


        <!-- Buttons -->
        <div class="mt-3">

            <button type="submit"
                    class="btn btn-primary">
                Save Doctor
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Doctor List
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}