@model HospitalManagementSystem.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<div class="container mt-4">

    <h2>Doctor Details</h2>

    <hr />

    <div class="card">

        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">@Model.FullName</h4>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-4">
                    Doctor ID
                </dt>

                <dd class="col-sm-8">
                    @Model.DoctorId
                </dd>


                <dt class="col-sm-4">
                    Full Name
                </dt>

                <dd class="col-sm-8">
                    @Model.FullName
                </dd>


                <dt class="col-sm-4">
                    Specialization
                </dt>

                <dd class="col-sm-8">
                    @Model.Specialization
                </dd>


                <dt class="col-sm-4">
                    Qualification
                </dt>

                <dd class="col-sm-8">
                    @Model.Qualification
                </dd>


                <dt class="col-sm-4">
                    Phone
                </dt>

                <dd class="col-sm-8">
                    @Model.Phone
                </dd>


                <dt class="col-sm-4">
                    Email
                </dt>

                <dd class="col-sm-8">
                    @Model.Email
                </dd>


                <dt class="col-sm-4">
                    Available Days
                </dt>

                <dd class="col-sm-8">
                    @Model.AvailableDays
                </dd>


                <dt class="col-sm-4">
                    Available Time
                </dt>

                <dd class="col-sm-8">
                    @Model.AvailableTime
                </dd>


                <dt class="col-sm-4">
                    Department ID
                </dt>

                <dd class="col-sm-8">
                    @Model.DepartmentId
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <a asp-action="Edit"
               asp-route-id="@Model.DoctorId"
               class="btn btn-warning">
                Edit Doctor
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Doctor List
            </a>

        </div>

    </div>

</div>